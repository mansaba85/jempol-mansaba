# Database Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/jempol_db"

# Security — WAJIB diisi string acak yang panjang (min. 32 karakter).
# Server tidak akan jalan jika JWT_SECRET kosong. Jangan pernah commit nilai aslinya.
JWT_SECRET="ganti_dengan_kode_acak_yang_panjang_dan_rahasia"

# Seed admin awal — hanya dipakai jika user admin belum ada di database.
# Admin yang sudah ada tidak terpengaruh oleh nilai ini.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# App Port
PORT=3001
